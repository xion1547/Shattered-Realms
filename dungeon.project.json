{
  "name": "Shattered-Realms",
  "globIgnorePaths": ["**/.gitkeep"],
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "$path": "src/shared",

      "Effects": {
        "$path": "assets/effects"
      }
    },

    "ServerStorage": {
      "Shared": {
        "$path": "src/serverShared"
      },

      "Models": {
        "$path": "assets/models"
      }
    },

    "ServerScriptService": {
      "Server": {
        "$path": "src/gameModes/dungeon/server"
      }
    },

    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/gameModes/dungeon/client"
        }
      }
    },

    "StarterGui": {
      "UI": {
        "$path": "src/gameModes/dungeon/ui"
      }
    },

    "Workspace": {
      "$properties": {
        "FilteringEnabled": true
      },
      "Baseplate": {
        "$className": "Part",
        "$properties": {
          "Anchored": true,
          "Color": [0.38823, 0.37254, 0.38823],
          "Locked": true,
          "Position": [0, -10, 0],
          "Size": [512, 20, 512]
        }
      }
    },
    "Lighting": {
      "$properties": {
        "Ambient": [0, 0, 0],
        "Brightness": 2,
        "GlobalShadows": true,
        "Outlines": false,
        "Technology": "Voxel"
      }
    },
    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}
